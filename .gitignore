# Build output — regenerated by `packaging/build.ps1`, and large. The installer
# and its checksum live in dist/installer/ and are uploaded to a GitHub release
# rather than committed: a 40 MB binary per version would bloat the repo for
# everyone who clones it, forever.
build/
dist/
*.spec.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Anyone's real financial data. The app defaults to ~/.ledgerline/ledgerline.db
# so this should never trigger, but a --db pointed at the working tree would
# otherwise be one `git add .` away from being committed.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
